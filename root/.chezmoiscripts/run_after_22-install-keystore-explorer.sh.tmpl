#!/bin/bash

# {{ template "scripts-library" }}

# The following line is for ShellCheck to correctly identify the above included library
true || source ../.chezmoitemplates/scripts-library

{{ $release := gitHubLatestRelease "kaikramer/keystore-explorer" -}}
{{- $deb := "" -}}
{{- range $release.Assets -}}
{{-   if and (hasPrefix "kse_" .Name) (hasSuffix "_all.deb" .Name) -}}
{{-     $deb = . -}}
{{-   end -}}
{{- end -}}
{{- if not $deb -}}
{{-   fail "kaikramer/keystore-explorer: no kse_*_all.deb asset in the latest release" -}}
{{- end }}

# Resolved from the release assets, so the Debian revision is never hardcoded
keystore_explorer_deb="{{ $deb.Name }}"
keystore_explorer_url="{{ $deb.BrowserDownloadURL }}"
keystore_explorer_version_latest="{{ $deb.Name | trimPrefix "kse_" | trimSuffix "_all.deb" }}"

keystore_explorer_version_current=$(dpkg-query -W --showformat='${Version}' kse 2> /dev/null || echo "NOT_FOUND")

if [[ "${keystore_explorer_version_latest}" != "${keystore_explorer_version_current}" ]]; then
  log_task "Installing keystore-explorer - ${keystore_explorer_version_latest}"

  wget "${keystore_explorer_url}" --directory-prefix=/tmp/

  chmod u+r "/tmp/${keystore_explorer_deb}"

  c apt install --yes --no-install-recommends "/tmp/${keystore_explorer_deb}"

  rm -rf "/tmp/${keystore_explorer_deb}"
fi
