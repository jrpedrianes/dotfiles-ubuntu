{{- /* Given a JDT-LS milestone version (e.g. "1.58.0"), returns the build
       timestamp embedded in the Eclipse tarball filename (e.g. "202604151538").
       Eclipse does not expose this anywhere except in the autoindex HTML of the
       per-version directory, so this template scrapes it. */ -}}
{{- $version := . -}}
{{- $cmd := printf `set -euo pipefail
ts=$(curl -fsSL "https://download.eclipse.org/jdtls/milestones/%s/" | grep -oE "jdt-language-server-%s-[0-9]+\.tar\.gz" | grep -oE "[0-9]{12}" | sort -u | tail -1)
[ -n "$ts" ] || { echo "get-jdtls-build-timestamp: no tarball found for jdtls %s" >&2; exit 1; }
echo "$ts"` $version $version $version -}}
{{- output "bash" "-c" $cmd | trim -}}
