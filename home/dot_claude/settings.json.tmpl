{
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "jdtls-lsp@claude-plugins-official": true,
    "kuflow@kuflow-skills": true
  },
  "outputStyle": "Concise",
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark"
}
