{
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "enabledPlugins": {
    "jdtls-lsp@claude-plugins-official": true,
    "kuflow@kuflow-skills": true
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  }
}
