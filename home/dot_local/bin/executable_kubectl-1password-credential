#!/usr/bin/env bash
#
# kubectl exec credential plugin backed by 1Password.
#
# Credentials are read from 1Password (which asks for approval through the
# desktop app integration) and cached only in memory, in the kernel user
# keyring, with a hard TTL. Nothing is written to disk.
#
# Usage: kubectl-1password-credential <op cert ref> <op key ref>
#   KUBECTL_OP_CACHE_TTL  cache lifetime in seconds (default: 900)
#
# Lock all cached credentials: keyctl purge -p user kubectl-op:

set -euo pipefail

if [[ -n "${DOTFILES_DEBUG:-}" ]]; then
  set -x
fi

usage="usage: kubectl-1password-credential <op cert ref> <op key ref>"
cert_ref=${1:?${usage}}
key_ref=${2:?${usage}}
ttl=${KUBECTL_OP_CACHE_TTL:-900}
name="kubectl-op:$(printf '%s\n%s' "${cert_ref}" "${key_ref}" | sha256sum | cut -c1-16)"

function from_cache() {
  local id
  id=$(keyctl search @u user "${name}" 2>/dev/null) && keyctl pipe "${id}" 2>/dev/null
}

from_cache && exit 0

# Serialize cache misses so parallel kubectl calls trigger a single 1Password prompt
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/${name}.lock"
flock 9
from_cache && exit 0

expiration=$(date -u -d "+${ttl} seconds" +%Y-%m-%dT%H:%M:%SZ)
json=$(
  printf '{"c":"{{ %s }}","k":"{{ %s }}"}' "${cert_ref}" "${key_ref}" | op inject |
    jq -c --arg expiration "${expiration}" '{
      apiVersion: "client.authentication.k8s.io/v1",
      kind: "ExecCredential",
      status: {
        clientCertificateData: (.c | @base64d),
        clientKeyData: (.k | @base64d),
        expirationTimestamp: $expiration
      }
    }'
)

id=$(printf '%s' "${json}" | keyctl padd user "${name}" @u)
keyctl timeout "${id}" "${ttl}"
printf '%s' "${json}"
