#!/usr/bin/env bash
#
# kubectl exec credential plugin backed by 1Password.
#
# Credentials are read from 1Password (which asks for approval through the
# desktop app integration) and cached only in memory, in the kernel user
# keyring. Nothing is written to disk. The idle TTL is renewed on every use,
# capped by an absolute max TTL counted from the 1Password approval.
#
# Usage: kubectl-1password-credential <op cert ref> <op key ref>
#   KUBECTL_OP_CACHE_TTL      idle lifetime in seconds (default: 900)
#   KUBECTL_OP_CACHE_MAX_TTL  absolute lifetime in seconds (default: 28800)
#
# Lock all cached credentials: keyctl purge -p user kubectl-op:

set -euo pipefail

if [[ -n "${DOTFILES_DEBUG:-}" ]]; then
  set -x
fi

usage="usage: kubectl-1password-credential <op cert ref> <op key ref>"
cert_ref=${1:?${usage}}
key_ref=${2:?${usage}}
idle_ttl=${KUBECTL_OP_CACHE_TTL:-900}
max_ttl=${KUBECTL_OP_CACHE_MAX_TTL:-28800}
name="kubectl-op:$(printf '%s\n%s' "${cert_ref}" "${key_ref}" | sha256sum | cut -c1-16)"

function from_cache() {
  local id json remaining
  id=$(keyctl search @u user "${name}" 2>/dev/null) || return 1
  json=$(keyctl pipe "${id}" 2>/dev/null) || return 1
  remaining=$(($(date -d "$(jq -r '.status.expirationTimestamp' <<<"${json}")" +%s) - $(date +%s)))
  ((remaining > 0)) || return 1
  keyctl timeout "${id}" "$((remaining < idle_ttl ? remaining : idle_ttl))"
  printf '%s' "${json}"
}

from_cache && exit 0

# Serialize cache misses so parallel kubectl calls trigger a single 1Password prompt
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/${name}.lock"
flock 9
from_cache && exit 0

expiration=$(date -u -d "+${max_ttl} seconds" +%Y-%m-%dT%H:%M:%SZ)
json=$(
  printf '{"c":"{{ %s }}","k":"{{ %s }}"}' "${cert_ref}" "${key_ref}" | op inject |
    jq -c --arg expiration "${expiration}" '{
      apiVersion: "client.authentication.k8s.io/v1",
      kind: "ExecCredential",
      status: {
        clientCertificateData: (.c | @base64d),
        clientKeyData: (.k | @base64d),
        expirationTimestamp: $expiration
      }
    }'
)

id=$(printf '%s' "${json}" | keyctl padd user "${name}" @u)
keyctl timeout "${id}" "${idle_ttl}"
printf '%s' "${json}"
